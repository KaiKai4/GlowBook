{
  "ci": {
    "collect": {
      "startServerCommand": "npx next start -p 3200 -H 127.0.0.1",
      "startServerReadyPattern": "Ready",
      "startServerReadyTimeout": 120000,
      "url": [
        "http://127.0.0.1:3200/",
        "http://127.0.0.1:3200/appointments",
        "http://127.0.0.1:3200/customers",
        "http://127.0.0.1:3200/reports"
      ],
      "numberOfRuns": 3,
      "puppeteerScript": "scripts/quality/lighthouse-session.cjs",
      "settings": {
        "disableStorageReset": true
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 1 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci-auth"
    }
  }
}
