# Copy this to .env.local and fill in your Supabase project values.
# NEVER commit .env.local to git.

# Environment guard used by tests, staging E2E and smoke scripts.
# Valid values: local, staging, production.
GLOWBOOK_ENV=local

# Public app URL for redirects, emails and operational checks.
APP_URL=http://127.0.0.1:3000

# Supabase project URL (public; safe for browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/publishable key (public; RLS is the security layer).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service_role key (SERVER ONLY; bypasses RLS; NEVER prefix with NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Production Supabase URL used only as a safety guard by tests and scripts.
PRODUCTION_SUPABASE_URL=https://your-production-project-id.supabase.co

# Optional Vercel Deployment Protection bypass for automated staging checks.
# Create it in Vercel Project Settings and keep it server/local only.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Optional observability log drain/webhook. Leave empty to use hosting logs only.
GLOWBOOK_OBSERVABILITY_WEBHOOK_URL=
GLOWBOOK_OBSERVABILITY_WEBHOOK_TOKEN=
GLOWBOOK_OBSERVABILITY_REQUIRE_WEBHOOK=
GLOWBOOK_OBSERVABILITY_REQUIRE_ALERTS=
GLOWBOOK_OBSERVABILITY_ALERT_5XX=
GLOWBOOK_OBSERVABILITY_ALERT_SUPABASE_ERRORS=
GLOWBOOK_OBSERVABILITY_ALERT_PLATFORM_ERRORS=
GLOWBOOK_OBSERVABILITY_ALERT_LATENCY=
GLOWBOOK_OBSERVABILITY_RETENTION_DAYS=
GLOWBOOK_CSP_REPORT_ONLY=
GLOWBOOK_SUPPORT_REQUIRE_CONFIRMED_CHANNELS=
GLOWBOOK_SUPPORT_OWNER=
GLOWBOOK_SUPPORT_BACKUP_OWNER=
GLOWBOOK_SUPPORT_CHANNEL=
GLOWBOOK_SUPPORT_FIRST_WEEK_SCHEDULE=
GLOWBOOK_CAPACITY_REQUIRE_CONFIRMED_LIMITS=
GLOWBOOK_CAPACITY_SUPABASE_PLAN=
GLOWBOOK_CAPACITY_SUPABASE_REGION=
GLOWBOOK_CAPACITY_SUPABASE_BACKUPS=
GLOWBOOK_CAPACITY_SUPABASE_CONNECTIONS=
GLOWBOOK_CAPACITY_SUPABASE_AUTH_LIMITS=
GLOWBOOK_CAPACITY_VERCEL_PLAN=
GLOWBOOK_CAPACITY_VERCEL_REGION=
GLOWBOOK_CAPACITY_VERCEL_BANDWIDTH=
GLOWBOOK_CAPACITY_VERCEL_ALERTS=
GLOWBOOK_RESTORE_REQUIRE_BUSINESS_RTO_RPO=
GLOWBOOK_RESTORE_RTO=
GLOWBOOK_RESTORE_RPO=
GLOWBOOK_RESTORE_OWNER=
GLOWBOOK_REMINDERS_AUTOMATIC_CONFIRMED=
GLOWBOOK_PERFORMANCE_REQUIRE_ROUTE_MEASUREMENTS=
GLOWBOOK_BASELINE_REQUIRE_SIGNED_DECISION=
GLOWBOOK_SCALE_DECISION_OWNER=
GLOWBOOK_SCALE_DECISION_DATE=
GLOWBOOK_SCALE_DECISION_APPROVED_STAGE=
GLOWBOOK_RATE_LIMIT_REQUIRE_PROVIDER_CONFIRMATION=
GLOWBOOK_RATE_LIMIT_PROVIDER=
GLOWBOOK_RATE_LIMIT_LOGIN=
GLOWBOOK_RATE_LIMIT_INVITATIONS=
GLOWBOOK_RATE_LIMIT_FEEDBACK=
GLOWBOOK_RATE_LIMIT_PLATFORM=
GLOWBOOK_SECURITY_REQUIRE_OPERATION_CONFIRMATION=
GLOWBOOK_SECURITY_OWNER=
GLOWBOOK_SECURITY_CSP_REPORT_REVIEWED=
GLOWBOOK_SECURITY_SECRET_ROTATION_STATUS=
GLOWBOOK_SECURITY_LOG_SECRET_SCAN=
GLOWBOOK_PERFORMANCE_REQUIRE_VERCEL_LOG_REVIEW=
GLOWBOOK_PERFORMANCE_LOG_REVIEW_OWNER=
GLOWBOOK_PERFORMANCE_LOG_REVIEW_DATE=
GLOWBOOK_PERFORMANCE_LOG_REVIEW_WINDOW=
GLOWBOOK_PERFORMANCE_LOG_REVIEW_MAX_5XX=
GLOWBOOK_PERFORMANCE_LOG_REVIEW_MAX_FUNCTION_DURATION_MS=
GLOWBOOK_PERFORMANCE_LOG_REVIEW_SECRETS_VISIBLE=

# E2E against deployed staging.
E2E_BASE_URL=https://your-staging-app.example.com
E2E_SALON_OWNER_EMAIL=
E2E_SALON_OWNER_PASSWORD=
E2E_PLATFORM_ADMIN_EMAIL=
E2E_PLATFORM_ADMIN_PASSWORD=

# Staging smoke seed confirmation.
# Set only when running: npm run smoke:seed-5-salons
SMOKE_SEED_CONFIRM=
SMOKE_SEED_BATCH_ID=

# Staging smoke cleanup confirmation.
# Set only when running: npm run smoke:cleanup-5-salons
SMOKE_CLEANUP_CONFIRM=

# Staging scale dataset seed/cleanup.
# Set only when running: npm run scale:seed-salons or npm run scale:cleanup-salons
SCALE_SEED_CONFIRM=
SCALE_CLEANUP_CONFIRM=
SCALE_SEED_BATCH_ID=
SCALE_CLEANUP_BATCH_ID=
SCALE_SALON_COUNT=
SCALE_EMPLOYEES_PER_SALON=
SCALE_CATEGORIES_PER_SALON=
SCALE_SERVICES_PER_CATEGORY=
SCALE_CUSTOMERS_PER_SALON=
SCALE_APPOINTMENTS_PER_SALON=

# Staging route timing with an existing scale batch.
# Set only when running: npm run scale:measure-routes
SCALE_MEASURE_CONFIRM=
SCALE_MEASURE_BATCH_ID=
SCALE_MEASURE_OWNER_EMAIL=
SCALE_MEASURE_OWNER_PASSWORD=

# Broad launch readiness confirmations.
# These must be set only after each phase has real evidence.
SCALE_BASELINE_CONFIRMED=
SCALE_ISOLATION_CONFIRMED=
SCALE_DATASET_CONFIRMED=
SCALE_PERFORMANCE_CONFIRMED=
SCALE_OBSERVABILITY_CONFIRMED=
SCALE_CAPACITY_CONFIRMED=
SCALE_RESTORE_CONFIRMED=
SCALE_SECURITY_CONFIRMED=
SCALE_SUPPORT_CONFIRMED=
SCALE_REMINDERS_DECISION_CONFIRMED=
