# Copy this to .env.local and fill in your Supabase project values.
# NEVER commit .env.local to git.

# Environment guard used by tests, staging E2E and smoke scripts.
# Valid values: local, staging, production.
GLOWBOOK_ENV=local

# Public app URL for redirects, emails and operational checks.
APP_URL=http://127.0.0.1:3000

# Supabase project URL (public; safe for browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/publishable key (public; RLS is the security layer).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service_role key (SERVER ONLY; bypasses RLS; NEVER prefix with NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Production Supabase URL used only as a safety guard by tests and scripts.
PRODUCTION_SUPABASE_URL=https://your-production-project-id.supabase.co

# Optional observability log drain/webhook. Leave empty to use hosting logs only.
GLOWBOOK_OBSERVABILITY_WEBHOOK_URL=
GLOWBOOK_OBSERVABILITY_WEBHOOK_TOKEN=

# E2E against deployed staging.
E2E_BASE_URL=https://your-staging-app.example.com
E2E_SALON_OWNER_EMAIL=
E2E_SALON_OWNER_PASSWORD=
E2E_PLATFORM_ADMIN_EMAIL=
E2E_PLATFORM_ADMIN_PASSWORD=

# Staging smoke seed confirmation.
# Set only when running: npm run smoke:seed-5-salons
SMOKE_SEED_CONFIRM=
SMOKE_SEED_BATCH_ID=

# Staging smoke cleanup confirmation.
# Set only when running: npm run smoke:cleanup-5-salons
SMOKE_CLEANUP_CONFIRM=
