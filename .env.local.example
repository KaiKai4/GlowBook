# Copiar a .env.local. Nunca versionar claves reales.
# Desarrollo: obtener las credenciales del stack local con npm run db:start.
GLOWBOOK_ENV=local
APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
# Solo servidor; nunca usar el prefijo NEXT_PUBLIC_ para esta clave.
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
# Guarda para impedir que scripts de pruebas apunten a producción.
PRODUCTION_SUPABASE_URL=https://your-production-project-id.supabase.co

# En Vercel configurar APP_URL y las tres variables Supabase de producción.
# Credenciales de deploy: GitHub Secrets, no este archivo. Ver docs/runbooks/deploy.md.
# Opciones de observabilidad: docs/security.md. No se necesita staging.
